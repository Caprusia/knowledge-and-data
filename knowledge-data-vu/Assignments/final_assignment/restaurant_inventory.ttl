@prefix : <http://www.semanticweb.org/boris/ontologies/2026/restaurant-inventory#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/2001/XMLSchema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix kitchen: <http://www.semanticweb.org/boris/ontologies/2026/restaurant-inventory#> .
@base <http://www.semanticweb.org/boris/ontologies/2026/restaurant-inventory#> .

<http://www.semanticweb.org/boris/ontologies/2026/restaurant-inventory> rdf:type owl:Ontology ;
                                                                         rdfs:comment "An Ordered Inventory System for Restaurants: Equipment and Investment Planning Ontology" .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/boris/ontologies/2026/restaurant-inventory#assignedToStation
kitchen:assignedToStation rdf:type owl:ObjectProperty ,
                                   owl:AsymmetricProperty ,
                                   owl:IrreflexiveProperty ;
                          rdfs:domain kitchen:Chef ;
                          rdfs:range kitchen:KitchenStation .


###  http://www.semanticweb.org/boris/ontologies/2026/restaurant-inventory#hasSafetyRule
kitchen:hasSafetyRule rdf:type owl:ObjectProperty ,
                               owl:IrreflexiveProperty ;
                      rdfs:domain kitchen:Equipment ;
                      rdfs:range kitchen:SafetyRule .


###  http://www.semanticweb.org/boris/ontologies/2026/restaurant-inventory#locatedInStation
kitchen:locatedInStation rdf:type owl:ObjectProperty ,
                                  owl:FunctionalProperty ,
                                  owl:AsymmetricProperty ,
                                  owl:IrreflexiveProperty ;
                         rdfs:domain kitchen:Equipment ;
                         rdfs:range kitchen:KitchenStation .


###  http://www.semanticweb.org/boris/ontologies/2026/restaurant-inventory#requiresUtility
kitchen:requiresUtility rdf:type owl:ObjectProperty ,
                                 owl:AsymmetricProperty ,
                                 owl:IrreflexiveProperty ;
                        rdfs:domain kitchen:Equipment ;
                        rdfs:range kitchen:UtilityRequirement .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/boris/ontologies/2026/restaurant-inventory#hasCost
kitchen:hasCost rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain kitchen:Equipment ;
                rdfs:range xsd:decimal .


###  http://www.semanticweb.org/boris/ontologies/2026/restaurant-inventory#quantityInStock
kitchen:quantityInStock rdf:type owl:DatatypeProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain kitchen:InventoryItem ;
                        rdfs:range xsd:integer .


###  http://www.semanticweb.org/boris/ontologies/2026/restaurant-inventory#ruleDescription
kitchen:ruleDescription rdf:type owl:DatatypeProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain kitchen:SafetyRule ;
                        rdfs:range xsd:string .


###  http://www.semanticweb.org/boris/ontologies/2026/restaurant-inventory#temp
kitchen:temp rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain kitchen:RefrigerationUnit ;
             rdfs:range xsd:decimal .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/boris/ontologies/2026/restaurant-inventory#Chef
kitchen:Chef rdf:type owl:Class ;
             rdfs:subClassOf foaf:Person .


###  http://www.semanticweb.org/boris/ontologies/2026/restaurant-inventory#CookingAppliance
kitchen:CookingAppliance rdf:type owl:Class ;
                         rdfs:subClassOf kitchen:Equipment ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty kitchen:requiresUtility ;
                                           owl:someValuesFrom kitchen:UtilityRequirement
                                         ] .


###  http://www.semanticweb.org/boris/ontologies/2026/restaurant-inventory#Equipment
kitchen:Equipment rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty kitchen:locatedInStation ;
                                    owl:allValuesFrom kitchen:KitchenStation
                                  ] .


###  http://www.semanticweb.org/boris/ontologies/2026/restaurant-inventory#InventoryItem
kitchen:InventoryItem rdf:type owl:Class .


###  http://www.semanticweb.org/boris/ontologies/2026/restaurant-inventory#KitchenStation
kitchen:KitchenStation rdf:type owl:Class .


###  http://www.semanticweb.org/boris/ontologies/2026/restaurant-inventory#RefrigerationUnit
kitchen:RefrigerationUnit rdf:type owl:Class ;
                          rdfs:subClassOf kitchen:Equipment .


###  http://www.semanticweb.org/boris/ontologies/2026/restaurant-inventory#SafetyRule
kitchen:SafetyRule rdf:type owl:Class .


###  http://www.semanticweb.org/boris/ontologies/2026/restaurant-inventory#StorageUnit
kitchen:StorageUnit rdf:type owl:Class ;
                    rdfs:subClassOf kitchen:Equipment .


###  http://www.semanticweb.org/boris/ontologies/2026/restaurant-inventory#Utensils
kitchen:Utensils rdf:type owl:Class ;
                 rdfs:subClassOf kitchen:Equipment .


###  http://www.semanticweb.org/boris/ontologies/2026/restaurant-inventory#UtilityRequirement
kitchen:UtilityRequirement rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Person
foaf:Person rdf:type owl:Class .


